# Belt and braces: tsc must never emit beside the sources. `npm run typecheck`
# keeps noEmit on; these rules guarantee an accidental emit can never be committed.
src/**/*.js
src/**/*.d.ts
vite.config.js
vite.config.d.ts
vitest.config.js
vitest.config.d.ts
eslint.config.js
.env
.env.*
!.env.example
# A dev server started with output redirected to a file leaves a log full of ANSI
# escapes behind. It is a local artifact, not something to review.
vite.log
# An export or migration acceptance run that is not given an explicit download directory
# resolves Playwright's default against the working directory, which lands a stray
# `.zanza.json` here. Local artifact, not something to review.
out/

.vercel
.env*
